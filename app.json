{
  "expo": {
    "name": "Home Easy",
    "slug": "homeeasy-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.homeeasy.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.homeeasy.mobile",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "A Home Easy usa sua localização para encontrar profissionais dentro do raio escolhido."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "A Home Easy acessa suas fotos somente para anexos, documentos e foto de perfil."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5531442d-8c7c-4d59-acca-ae1e045d4f24"
      }
    },
    "owner": "alvaromgueiros"
  }
}
